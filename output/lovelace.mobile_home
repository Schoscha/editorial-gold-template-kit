{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.mobile_home",
  "data": {
    "config": {
      "title": "Atelier Home",
      "views": [
        {
          "path": "home",
          "title": "Home",
          "icon": "mdi:home-outline",
          "theme": "Editorial Gold",
          "type": "sections",
          "max_columns": 1,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:editorial-hero-card",
                  "title": "ATELIER HOME",
                  "badge": "Editorial Gold",
                  "user_name": "Gastgeber",
                  "subtitle": "Kompakte Mobil-Steuerung"
                },
                {
                  "type": "custom:mushroom-chips-card",
                  "alignment": "center",
                  "chips": [
                    {
                      "type": "weather",
                      "entity": "weather.home",
                      "show_temperature": true,
                      "show_conditions": false
                    },
                    {
                      "type": "template",
                      "icon": "mdi:lightbulb-group",
                      "icon_color": "{% if ({{ [states('light.living_pendant'), states('light.kitchen_ceiling'), states('light.bedroom_sphere'), states('light.studio_desk_lamp')] | select('eq', 'on') | list | count }} | int) > 0 %}amber{% else %}grey{% endif %}",
                      "content": "{{ [states('light.living_pendant'), states('light.kitchen_ceiling'), states('light.bedroom_sphere'), states('light.studio_desk_lamp')] | select('eq', 'on') | list | count }} an",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "raeume"
                      }
                    },
                    {
                      "type": "template",
                      "icon": "mdi:shield-home-outline",
                      "icon_color": "{% set c = [states('binary_sensor.front_door'), states('binary_sensor.living_window_right'), states('binary_sensor.bedroom_window')] | select('eq', 'on') | list | count %}{{ 'red' if c > 0 else 'green' }}",
                      "content": "{% set c = [states('binary_sensor.front_door'), states('binary_sensor.living_window_right'), states('binary_sensor.bedroom_window')] | select('eq', 'on') | list | count %}{{ c ~ ' offen' if c > 0 else 'Alles zu' }}",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "status"
                      }
                    },
                    {
                      "type": "entity",
                      "entity": "sensor.mobile_battery_level",
                      "icon": "mdi:cellphone-charging",
                      "icon_color": "amber"
                    },
                    {
                      "type": "template",
                      "icon": "mdi:microphone-outline",
                      "icon_color": "amber",
                      "content": "Assist",
                      "tap_action": {
                        "action": "assist",
                        "start_listening": true
                      }
                    }
                  ]
                },
                {
                  "type": "heading",
                  "heading": "Schnellsteuerung",
                  "heading_style": "title",
                  "icon": "mdi:lightning-bolt-outline"
                },
                {
                  "type": "grid",
                  "columns": 2,
                  "square": false,
                  "cards": [
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.living_pendant",
                      "name": "Wohnbereich · Esstisch Pendel",
                      "icon": "mdi:ceiling-light",
                      "layout": "vertical",
                      "fill_container": true,
                      "use_light_color": false,
                      "show_brightness_control": true,
                      "show_color_control": true,
                      "collapsible_controls": true,
                      "icon_color": "amber",
                      "card_mod": {
                        "style": {
                          ".": ":host {\n  --primary-text-color: #181c22 !important;\n  --secondary-text-color: #5c4f3d !important;\n  --card-primary-color: #181c22 !important;\n  --card-secondary-color: #5c4f3d !important;\n  --ha-color-text-primary: #181c22 !important;\n  --ha-color-text-secondary: #5c4f3d !important;\n  --rgb-amber: 181, 137, 45 !important;\n  --rgb-state-light: 181, 137, 45 !important;\n  --mush-rgb-amber: 181, 137, 45 !important;\n  --mush-rgb-state-light: 181, 137, 45 !important;\n  --slider-color: #b5892d !important;\n  --slider-bg-color: rgba(181, 137, 45, 0.22) !important;\n}\nha-card {\n  background: linear-gradient(145deg, #f5ecd9 0%, #eadbc0 100%) !important;\n  border: 1px solid #c59b5f !important;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25) !important;\n}\n",
                          "mushroom-state-info$": ".primary {\n  color: #181c22 !important;\n  font-weight: 600 !important;\n}\n.secondary {\n  color: #5c4f3d !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.kitchen_ceiling",
                      "name": "Deckenlicht Küche",
                      "icon": "mdi:ceiling-light-outline",
                      "layout": "vertical",
                      "fill_container": true,
                      "use_light_color": false,
                      "show_brightness_control": true,
                      "show_color_control": true,
                      "collapsible_controls": true,
                      "icon_color": "amber",
                      "card_mod": {
                        "style": {
                          ".": ":host {\n  --primary-text-color: #181c22 !important;\n  --secondary-text-color: #5c4f3d !important;\n  --card-primary-color: #181c22 !important;\n  --card-secondary-color: #5c4f3d !important;\n  --ha-color-text-primary: #181c22 !important;\n  --ha-color-text-secondary: #5c4f3d !important;\n  --rgb-amber: 181, 137, 45 !important;\n  --rgb-state-light: 181, 137, 45 !important;\n  --mush-rgb-amber: 181, 137, 45 !important;\n  --mush-rgb-state-light: 181, 137, 45 !important;\n  --slider-color: #b5892d !important;\n  --slider-bg-color: rgba(181, 137, 45, 0.22) !important;\n}\nha-card {\n  background: linear-gradient(145deg, #f5ecd9 0%, #eadbc0 100%) !important;\n  border: 1px solid #c59b5f !important;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25) !important;\n}\n",
                          "mushroom-state-info$": ".primary {\n  color: #181c22 !important;\n  font-weight: 600 !important;\n}\n.secondary {\n  color: #5c4f3d !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.bedroom_sphere",
                      "name": "Schlafzimmer · Nachttisch Kugel",
