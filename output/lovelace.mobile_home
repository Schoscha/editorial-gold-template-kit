                      "layout": "vertical",
                      "fill_container": true,
                      "use_light_color": false,
                      "show_brightness_control": true,
                      "show_color_control": true,
                      "collapsible_controls": true,
                      "icon_color": "amber",
                      "card_mod": {
                        "style": {
                          ".": ":host {\n  --primary-text-color: #181c22 !important;\n  --secondary-text-color: #5c4f3d !important;\n  --card-primary-color: #181c22 !important;\n  --card-secondary-color: #5c4f3d !important;\n  --ha-color-text-primary: #181c22 !important;\n  --ha-color-text-secondary: #5c4f3d !important;\n  --rgb-amber: 181, 137, 45 !important;\n  --rgb-state-light: 181, 137, 45 !important;\n  --mush-rgb-amber: 181, 137, 45 !important;\n  --mush-rgb-state-light: 181, 137, 45 !important;\n  --slider-color: #b5892d !important;\n  --slider-bg-color: rgba(181, 137, 45, 0.22) !important;\n}\nha-card {\n  background: linear-gradient(145deg, #f5ecd9 0%, #eadbc0 100%) !important;\n  border: 1px solid #c59b5f !important;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25) !important;\n}\n",
                          "mushroom-state-info$": ".primary {\n  color: #181c22 !important;\n  font-weight: 600 !important;\n}\n.secondary {\n  color: #5c4f3d !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.studio_desk_lamp",
                      "name": "Studio & Flur · Schreibtischlampe",
                      "icon": "mdi:desk-lamp",
                      "layout": "vertical",
                      "fill_container": true,
                      "use_light_color": false,
                      "show_brightness_control": true,
                      "show_color_control": true,
                      "collapsible_controls": true,
                      "icon_color": "amber",
                      "card_mod": {
                        "style": {
                          ".": ":host {\n  --primary-text-color: #181c22 !important;\n  --secondary-text-color: #5c4f3d !important;\n  --card-primary-color: #181c22 !important;\n  --card-secondary-color: #5c4f3d !important;\n  --ha-color-text-primary: #181c22 !important;\n  --ha-color-text-secondary: #5c4f3d !important;\n  --rgb-amber: 181, 137, 45 !important;\n  --rgb-state-light: 181, 137, 45 !important;\n  --mush-rgb-amber: 181, 137, 45 !important;\n  --mush-rgb-state-light: 181, 137, 45 !important;\n  --slider-color: #b5892d !important;\n  --slider-bg-color: rgba(181, 137, 45, 0.22) !important;\n}\nha-card {\n  background: linear-gradient(145deg, #f5ecd9 0%, #eadbc0 100%) !important;\n  border: 1px solid #c59b5f !important;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25) !important;\n}\n",
                          "mushroom-state-info$": ".primary {\n  color: #181c22 !important;\n  font-weight: 600 !important;\n}\n.secondary {\n  color: #5c4f3d !important;\n}\n"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Hermes Assist starten",
                  "secondary": "Sprachbefehl senden",
                  "icon": "mdi:microphone",
                  "icon_color": "amber",
                  "layout": "horizontal",
                  "tap_action": {
                    "action": "assist",
                    "start_listening": true
                  },
                  "card_mod": {
                    "style": {
                      ".": ":host {\n  --primary-text-color: #f3ead8 !important;\n  --secondary-text-color: #e6c978 !important;\n  --card-primary-color: #f3ead8 !important;\n  --card-secondary-color: #e6c978 !important;\n}\nha-card {\n  background: linear-gradient(135deg, #242b35 0%, #171c23 100%) !important;\n  border: 1px solid #d4af37 !important;\n}\n",
                      "mushroom-state-info$": ".primary {\n  color: #f3ead8 !important;\n  font-weight: 600 !important;\n}\n.secondary {\n  color: #e6c978 !important;\n}\n"
                    }
                  }
                },
                {
                  "type": "heading",
                  "heading": "Medien",
                  "heading_style": "title",
                  "icon": "mdi:speaker"
                },
                {
                  "type": "custom:mushroom-media-player-card",
                  "entity": "media_player.living_speaker",
                  "name": "Wohnbereich Speaker",
                  "icon": "mdi:speaker",
                  "layout": "horizontal",
                  "fill_container": true,
                  "use_media_info": true,
                  "show_volume_level": true,
                  "volume_controls": [
                    "volume_mute",
                    "volume_buttons"
                  ],
                  "media_controls": [
                    "on_off",
                    "play_pause_stop"
                  ],
                  "collapsible_controls": true
                },
                {
                  "type": "custom:mushroom-media-player-card",
                  "entity": "media_player.living_tv",
                  "name": "Smart TV",
                  "icon": "mdi:television",
                  "layout": "horizontal",
                  "fill_container": true,
                  "use_media_info": true,
                  "show_volume_level": true,
                  "volume_controls": [
                    "volume_mute",
                    "volume_buttons"
                  ],
                  "media_controls": [
                    "on_off",
                    "play_pause_stop"
                  ],
                  "collapsible_controls": true
                },
                {
                  "type": "custom:golden-streams-card",
                  "title": "Golden Data Streams",
                  "subtitle": "Echtzeit-Telemetrie · Atelier Home",
                  "height": 220,
                  "nodes": [
                    {
                      "label": "Internet-Durchsatz",
                      "subtitle": "FRITZ!Box 7520 Download",
                      "entity": "sensor.gateway_download"
                    },
                    {
                      "label": "Beleuchtung",
                      "subtitle": "Aktive Lampen im Zuhause",
                      "entity": "light.living_pendant",
                      "type": "lights_count",
                      "entities": [
                        "light.living_pendant",
                        "light.kitchen_ceiling",
                        "light.bedroom_sphere",
                        "light.studio_desk_lamp"
                      ]
                    },
                    {
                      "label": "Türen & Fenster",
                      "subtitle": "Alle Kontakt-Sensoren",
                      "entity": "binary_sensor.front_door",
                      "type": "doors_count",
                      "entities": [
                        "binary_sensor.front_door",
                        "binary_sensor.living_window_right",
                        "binary_sensor.bedroom_window"
                      ]
                    },
                    {
                      "label": "Bewegung & Präsenz",
                      "subtitle": "Flur · Küche · WoZi · Terrasse",
                      "entity": "binary_sensor.living_motion",
                      "type": "motion_count",
                      "entities": [
                        "binary_sensor.living_motion",
                        "binary_sensor.kitchen_motion"
                      ]
                    },
                    {
                      "label": "System & Backup",
                      "subtitle": "Zigbee2MQTT & Sicherung",
                      "entity": "sensor.backup_state"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "heading": "Sicherheit & WLAN",
                  "heading_style": "title",
                  "icon": "mdi:shield-outline"
                },
                {
                  "type": "entities",
                  "state_color": true,
                  "entities": [
                    {
                      "entity": "binary_sensor.front_door",
                      "name": "Eingangstür"
                    },
                    {
                      "entity": "binary_sensor.living_window_right",
                      "name": "Wohnbereich Fenster"
                    },
                    {
                      "entity": "binary_sensor.bedroom_smoke",
                      "name": "Rauchmelder Schlafzimmer"
                    },
                    {
                      "entity": "switch.gateway_guest_wifi",
                      "name": "Gast-WLAN"
                    }
                  ]
                }
              ]
            }
          ]
        },
